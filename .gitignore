# Python cache
__pycache__

# IntelliJ/PyCharm cache
.idea

# Anything starting with three underscores
___*
# RocketSimVis local/user state and generated caches
src/rsv_settings.json
src/rsv_crash.txt
src/*.bak
data/landscape_cache.npy

# decoded sound bank for clip rendering (auto-built on first clip)
data/sounds_cache/
src/rsv_events.log
# rendered clips + their logs
clips/
# your own sound files (only the manifest + README are part of the repo)
data/sounds/*.ogg
data/sounds/*.wav
data/sounds/*.mp3
data/sounds/*.flac
data/sounds/engine_src/
# per-map scenery meshes (maps.py), rebuilt on demand
data/scene_*_cache.npz

# local tools (e.g. bin/ffmpeg/ffmpeg.exe for clips) and temp files
bin/
*.exe
*.dll
*.tmp
